# .wiki_ignore — files/dirs excluded from staleness detection
# Add project-specific patterns below. Lines starting with # are comments.

# Wiki self-ignore — wiki edits don't trigger staleness
docs/wiki/

# Common build/dependency/cache directories
node_modules/
dist/
build/
.next/
.cache/
__pycache__/
.DS_Store

# Project-specific: historical archives, tooling state, generated docs site
.archive/
.svelte-kit/
.cargo/
.work/
.pi/
.opencode/
data.monster/

# Data & secrets — never scan
.env
global_superstore.csv
data/

# Rust build tree (thousands of files)
src-tauri/target/

# CDP / vite debugging scratch (2026-09-14 bar-chart hang investigation)
.tmp-cdp-profile/
.tmp-*
.tmp-wv2-cdp/
.vite-dev.log

# Transient dev-server log (gitignored 2026-09-22) — runtime state, not doc-worthy
dev.log

# Generated verification screenshots from dev sessions (not project artifacts)
reports/*.png
